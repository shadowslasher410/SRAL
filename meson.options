# =============================================================================
# SRAL Orchestrator Base Functionality & Feature Triggers
# =============================================================================
option(
  'dev_sanitizers',
  type: 'feature',
  value: 'disabled',
  description: 'Inject compilation runtime security sanitizers (-fsanitize=address,undefined)',
)
option(
  'build_tests',
  type: 'feature',
  value: 'auto',
  description: 'Compile and optimize unit testing executable layers',
)
option(
  'build_bindings',
  type: 'feature',
  value: 'auto',
   description: 'Expose management wrappers for foreign programming language bindings',
)
option(
  'install_binding_sources',
  type: 'feature',
  value: 'enabled',
  description: 'Package and export raw text binding wrapper code structures',
)
option(
  'hardening_arch_level',
  type: 'combo',
  choices: ['none', 'x86-64-v2', 'x86-64-v3', 'native'],
  value: 'none',
  description: 'Select targeted processor microarchitecture optimization matrix profile',
)
# =============================================================================
# Core Screen Reader Adapter Feature Selection Switches
# =============================================================================
option(
  'with_accesskit',
  type: 'feature',
  value: 'auto',
  description: 'Compile AccessKit multi-platform proxy layout engine support',
)
option(
  'with_chromevox',
  type: 'feature',
  value: 'disabled',
  description: 'Compile ChromeVox target hooks for WebAssembly targets',
)
option(
  'with_uia',
  type: 'feature',
  value: 'auto',
  description: 'Compile Microsoft Windows UI Automation integration features',
)
option(
  'with_nsspeech',
  type: 'feature',
  value: 'auto',
  description: 'Compile native Apple AppKit NSSpeechSynthesizer layers',
)
option(
  'with_nvda',
  type: 'feature',
  value: 'auto',
  description: 'Compile native NVDA Remote controller library automation engines',
)
option(
  'with_jaws',
  type: 'feature',
  value: 'auto',
  description: 'Compile Freedom Scientific JAWS API integration drivers',
)
option(
  'with_zdsr',
  type: 'feature',
  value: 'auto',
  description: 'Compile Chinese ZDSR screen reader integration API drivers',
)
option(
  'with_sapi',
  type: 'feature',
  value: 'auto',
  description: 'Compile Microsoft Windows native Speech API (SAPI) engine features',
)
option(
  'with_speech_dispatcher',
  type: 'feature',
  value: 'auto',
  description: 'Compile Linux desktop Speech Dispatcher socket pipelines',
)
option(
  'with_orca',
  type: 'feature',
  value: 'auto',
  description: 'Compile Linux AT-SPI2 D-Bus hooks for Orca screen-reader layers',
)
option(
  'with_brlapi',
  type: 'feature',
  value: 'auto',
  description: 'Compile BrlAPI braille display hardware driver client wrappers',
)
option(
  'with_voiceover',
  type: 'feature',
  value: 'auto',
  description: 'Compile native Apple macOS VoiceOver accessibility routing components',
)
option(
  'with_avspeech',
  type: 'feature',
  value: 'auto',
  description: 'Compile native Apple AVSpeechSynthesizer dynamic audio speech drivers',
)
option(
  'with_android_tts',
  type: 'feature',
  value: 'auto',
  description: 'Compile native Google Android Text-To-Speech API framework layers',
)
option(
  'with_android_accessibility',
  type: 'feature',
  value: 'auto',
  description: 'Compile Android Accessibility Framework and AccessibilityManager layers',
)
# =============================================================================
# Language Binding Automation Targets Generation Layout Controls
# =============================================================================
option(
  'binding_csharp',
  type: 'feature',
  value: 'auto',
  description: 'Expose target workspace pipelines for building Microsoft .NET C# wrappers',
)
option(
  'binding_rust',
  type: 'feature',
  value: 'auto',
  description: 'Expose target workspace pipelines for tracking Rust cargo library structures',
)
option(
  'binding_node',
  type: 'feature',
  value: 'auto',
  description: 'Expose target workspace pipelines compiling Node.js integration components',
)
option(
  'binding_go',
  type: 'feature',
  value: 'auto',
  description: 'Expose target workspace pipelines executing Go toolchain generation steps',
)
option(
  'binding_dart',
  type: 'feature',
  value: 'auto',
  description: 'Expose target workspace pipelines executing Dart/Flutter ecosystem elements',
)
option(
  'binding_lua',
  type: 'feature',
  value: 'auto',
  description: 'Expose target workspace pipelines validating and setting up Lua environments',
)
option(
  'binding_python',
  type: 'feature',
  value: 'auto',
  description: 'Expose target workspace pipelines packaging structural Python wheels',
)
option(
  'binding_wasm',
  type: 'feature',
  value: 'auto',
  description: 'Expose target workspace pipelines compiling structural WebAssembly bridge assets',
)